# Create the API key in Google AI Studio.
# Never commit your real .env file.
GEMINI_API_KEY=replace_with_your_key

# Stable generation model used for grounded answers.
GEMINI_GENERATION_MODEL=gemini-3.6-flash

# Retrieval quality gate. Adjust only during evaluation.
SEMANTIC_MINIMUM_SCORE=0.40

APP_SESSION_SECRET=replace_with_a_long_random_secret

# ------------------------------------------------------------
# Public portfolio demo protection
# ------------------------------------------------------------

# false = normal local development
# true  = public deployed demo
PUBLIC_DEMO_MODE=false

# Query rate limits
PUBLIC_DEMO_SHORT_WINDOW_SECONDS=300
PUBLIC_DEMO_SHORT_WINDOW_REQUESTS=8
PUBLIC_DEMO_DAILY_REQUESTS_PER_CLIENT=30
PUBLIC_DEMO_GLOBAL_DAILY_REQUESTS=200

# Maximum request body size
PUBLIC_DEMO_MAX_CONTENT_LENGTH_BYTES=16384

# Only enable when the deployment proxy supplies trusted
# X-Forwarded-For information.
TRUST_PROXY_HEADERS=false

# true in HTTPS production deployment
SESSION_COOKIE_SECURE=false

# Browser origins allowed to call this API
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server-side only.
# Never expose this through Vite / React.
PUBLIC_DEMO_ADMIN_KEY=
