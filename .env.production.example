# ============================================================
# Engineering Knowledge Copilot
# Public deployment configuration
# ============================================================

# Required server-side secret.
GEMINI_API_KEY=replace_with_deployment_secret

# Generation model.
GEMINI_GENERATION_MODEL=gemini-3.6-flash

# Retrieval threshold.
SEMANTIC_MINIMUM_SCORE=0.40

# Long random value supplied by hosting secret manager.
APP_SESSION_SECRET=replace_with_long_random_secret

# ------------------------------------------------------------
# Public-demo security
# ------------------------------------------------------------

PUBLIC_DEMO_MODE=true

PUBLIC_DEMO_SHORT_WINDOW_SECONDS=300
PUBLIC_DEMO_SHORT_WINDOW_REQUESTS=8

PUBLIC_DEMO_DAILY_REQUESTS_PER_CLIENT=30
PUBLIC_DEMO_GLOBAL_DAILY_REQUESTS=200

PUBLIC_DEMO_MAX_CONTENT_LENGTH_BYTES=16384

# Enable only after verifying the hosting proxy provides
# trustworthy forwarding headers.
TRUST_PROXY_HEADERS=false

# Production HTTPS deployment.
SESSION_COOKIE_SECURE=true

# Replace after frontend deployment.
FRONTEND_ORIGINS=https://replace-with-frontend-domain.example

# Optional. Leave unset for the public portfolio deployment
# unless an admin-only server workflow is intentionally needed.
PUBLIC_DEMO_ADMIN_KEY=
