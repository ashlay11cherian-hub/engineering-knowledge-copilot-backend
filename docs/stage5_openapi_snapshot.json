{
  "components": {
    "schemas": {
      "Citation": {
        "properties": {
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "supported_claim": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supported Claim"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "title"
        ],
        "title": "Citation",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "QueryDiagnostics": {
        "properties": {
          "accepted_evidence_count": {
            "title": "Accepted Evidence Count",
            "type": "integer"
          },
          "candidate_count": {
            "title": "Candidate Count",
            "type": "integer"
          },
          "gate_reason": {
            "title": "Gate Reason",
            "type": "string"
          },
          "generation_called": {
            "title": "Generation Called",
            "type": "boolean"
          },
          "generation_latency_ms": {
            "title": "Generation Latency Ms",
            "type": "integer"
          },
          "query_coverage": {
            "title": "Query Coverage",
            "type": "number"
          },
          "retrieval_latency_ms": {
            "title": "Retrieval Latency Ms",
            "type": "integer"
          },
          "top_semantic_score": {
            "title": "Top Semantic Score",
            "type": "number"
          },
          "total_latency_ms": {
            "title": "Total Latency Ms",
            "type": "integer"
          }
        },
        "required": [
          "candidate_count",
          "accepted_evidence_count",
          "generation_called",
          "gate_reason",
          "top_semantic_score",
          "query_coverage",
          "retrieval_latency_ms",
          "generation_latency_ms",
          "total_latency_ms"
        ],
        "title": "QueryDiagnostics",
        "type": "object"
      },
      "QueryRequest": {
        "properties": {
          "query": {
            "minLength": 3,
            "title": "Query",
            "type": "string"
          },
          "repository_id": {
            "title": "Repository Id",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "repository_id",
          "query"
        ],
        "title": "QueryRequest",
        "type": "object"
      },
      "QueryResponse": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "confidence": {
            "anyOf": [
              {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "diagnostics": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QueryDiagnostics"
              },
              {
                "type": "null"
              }
            ]
          },
          "repository_id": {
            "title": "Repository Id",
            "type": "string"
          },
          "retrieved_chunk_count": {
            "default": 0,
            "title": "Retrieved Chunk Count",
            "type": "integer"
          },
          "status": {
            "enum": [
              "answered",
              "insufficient_evidence",
              "conflicting_evidence",
              "error"
            ],
            "title": "Status",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "status",
          "answer",
          "repository_id",
          "user_id"
        ],
        "title": "QueryResponse",
        "type": "object"
      },
      "RepositorySummary": {
        "properties": {
          "document_count": {
            "title": "Document Count",
            "type": "integer"
          },
          "last_sync": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Sync"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "provider": {
            "enum": [
              "local_demo",
              "google_drive",
              "sharepoint"
            ],
            "title": "Provider",
            "type": "string"
          },
          "repository_id": {
            "title": "Repository Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "connected",
              "disconnected",
              "syncing",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "repository_id",
          "name",
          "provider",
          "status",
          "document_count"
        ],
        "title": "RepositorySummary",
        "type": "object"
      },
      "UserSummary": {
        "properties": {
          "assigned_programs": {
            "items": {
              "type": "string"
            },
            "title": "Assigned Programs",
            "type": "array"
          },
          "clearance": {
            "title": "Clearance",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "name",
          "role",
          "assigned_programs",
          "clearance"
        ],
        "title": "UserSummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
